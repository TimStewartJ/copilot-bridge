    "directory": "src/packages/spawn-offthread"
  },
  "homepage": "https://github.com/timstewartj/copilot-bridge/tree/master/src/packages/spawn-offthread#readme",
  "bugs": {
    "url": "https://github.com/timstewartj/copilot-bridge/issues"
  },
